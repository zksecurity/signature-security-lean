  good₁SumWords : PolynomiallyBounded (fun n => (parameters n).good₁.bounds.sum.words)
  bad₁Names : PolynomiallyBounded (fun n => (parameters n).bad₁.routines.slots)
  bad₁GeneratorTime : PolynomiallyBounded (fun n => (parameters n).bad₁.bounds.generator.time)
  bad₁GeneratorWords : PolynomiallyBounded (fun n => (parameters n).bad₁.bounds.generator.words)
  bad₁UpdateTime : PolynomiallyBounded (fun n => (parameters n).bad₁.bounds.update.time)
  bad₁UpdateWords : PolynomiallyBounded (fun n => (parameters n).bad₁.bounds.update.words)
  bad₁HashTime : PolynomiallyBounded (fun n => ((parameters n).bad₁.bounds.response false).time)
  bad₁HashWords : PolynomiallyBounded (fun n => ((parameters n).bad₁.bounds.response false).words)
  bad₁SignTime : PolynomiallyBounded (fun n => ((parameters n).bad₁.bounds.response true).time)
  bad₁SignWords : PolynomiallyBounded (fun n => ((parameters n).bad₁.bounds.response true).words)
  bad₁ExtractTime : PolynomiallyBounded (fun n => (parameters n).bad₁.bounds.extract.time)
  bad₁ExtractWords : PolynomiallyBounded (fun n => (parameters n).bad₁.bounds.extract.words)
  bad₁SumTime : PolynomiallyBounded (fun n => (parameters n).bad₁.bounds.sum.time)
  bad₁SumWords : PolynomiallyBounded (fun n => (parameters n).bad₁.bounds.sum.words)
  good₂Names : PolynomiallyBounded (fun n => (parameters n).good₂.routines.slots)
  good₂GeneratorTime : PolynomiallyBounded (fun n => (parameters n).good₂.bounds.generator.time)
  good₂GeneratorWords : PolynomiallyBounded (fun n => (parameters n).good₂.bounds.generator.words)
  good₂UpdateTime : PolynomiallyBounded (fun n => (parameters n).good₂.bounds.update.time)
  good₂UpdateWords : PolynomiallyBounded (fun n => (parameters n).good₂.bounds.update.words)
  good₂HashTime : PolynomiallyBounded (fun n => ((parameters n).good₂.bounds.response false).time)
  good₂HashWords : PolynomiallyBounded (fun n => ((parameters n).good₂.bounds.response false).words)
