/-- Hardness against every polynomial-resource solver in the fixed Caliper family. -/
def dlogHardness : Prop := dlogNonuniformHardness (fun n => (parameters n).frame.outer.port)
  (fun n => (parameters n).frame.shape.challenge) (fun n => (parameters n).frame.outer.good.extraction.scalar) generator keyGenerator

/-- The four executed solvers of a polynomial-resource attacker family are polynomial-resource solver families. -/
theorem reductions_nonuniform (resources : PolynomialResources parameters)
    (adversary : ∀ n, AlgebraicAdversary (parameters n)) :
    dlogNonuniformWithin (fun n => (parameters n).frame.outer.port) (fun n => (parameters n).frame.shape.challenge)
      (fun n => (parameters n).frame.outer.good.extraction.scalar) generator keyGenerator (fun n => (adversary n).caliperGood₁) ∧
    dlogNonuniformWithin (fun n => (parameters n).frame.outer.port) (fun n => (parameters n).frame.shape.challenge)
      (fun n => (parameters n).frame.outer.good.extraction.scalar) generator keyGenerator (fun n => (adversary n).caliperBad₁) ∧
    dlogNonuniformWithin (fun n => (parameters n).frame.outer.port) (fun n => (parameters n).frame.shape.challenge)
      (fun n => (parameters n).frame.outer.good.extraction.scalar) generator keyGenerator (fun n => (adversary n).caliperGood₂) ∧
    dlogNonuniformWithin (fun n => (parameters n).frame.outer.port) (fun n => (parameters n).frame.shape.challenge)
      (fun n => (parameters n).frame.outer.good.extraction.scalar) generator keyGenerator (fun n => (adversary n).caliperBad₂) :=
  ⟨dlogNonuniformWithin.of_pointwise _ _ _ _ _ _ (fun n => (parameters n).solverCode) (fun n => (parameters n).solverMemory)
      (fun n => (parameters n).goodTime₁) resources.wordBits resources.solverCode resources.solverMemory resources.goodTime₁
      (fun n => (adversary n).caliperGood₁_within),
    dlogNonuniformWithin.of_pointwise _ _ _ _ _ _ (fun n => (parameters n).solverCode) (fun n => (parameters n).solverMemory)
      (fun n => (parameters n).badTime₁) resources.wordBits resources.solverCode resources.solverMemory resources.badTime₁
      (fun n => (adversary n).caliperBad₁_within),
    dlogNonuniformWithin.of_pointwise _ _ _ _ _ _ (fun n => (parameters n).solverCode) (fun n => (parameters n).solverMemory)
      (fun n => (parameters n).goodTime₂) resources.wordBits resources.solverCode resources.solverMemory resources.goodTime₂
      (fun n => (adversary n).caliperGood₂_within),
    dlogNonuniformWithin.of_pointwise _ _ _ _ _ _ (fun n => (parameters n).solverCode) (fun n => (parameters n).solverMemory)
      (fun n => (parameters n).badTime₂) resources.wordBits resources.solverCode resources.solverMemory resources.badTime₂
      (fun n => (adversary n).caliperBad₂_within)⟩
end Signatures.Runtime.SyncWrapCaliper.Family
