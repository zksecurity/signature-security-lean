import Proofs.Runtime.Caliper.SyncWrapSecurity
import Proofs.Runtime.Caliper.DLogFamily
import Proofs.Runtime.Caliper.PolynomialBounds

/-! Polynomial resources for the four complete synchronized PS Caliper solvers. Only local
routine costs, caller allowances, encoding widths and capacities are premises; the complete
solvers' code, time and total memory follow. -/
namespace Signatures.Runtime.SyncWrapCaliper.Family
open Caliper CaliperBackend
open Signatures.Runtime.WeightedCaliper (base scalarTy indexTy pairTy QueryAllowance)

variable {F G₁ G₂ Period : Nat → Type} [∀ n, Field (F n)] [∀ n, SampleableType (F n)] [∀ n, DecidableEq (Period n)]
  [∀ n, AddCommGroup (G₁ n)] [∀ n, Module (F n) (G₁ n)] [∀ n, AddCommGroup (G₂ n)] [∀ n, Module (F n) (G₂ n)]
  {queries : Nat → QueryAllowance} {generator : ∀ n, G₁ n} {keyGenerator : ∀ n, G₂ n}
  (parameters : ∀ n, Parameters (F n) (G₁ n) (G₂ n) (Period n) (queries n) (generator n) (keyGenerator n))

structure PolynomialResources : Prop where
  totalQueries : PolynomiallyBounded (fun n => (queries n).total)
  signQueries : PolynomiallyBounded (fun n => (queries n).sign)
  wordBits : PolynomiallyBounded (fun n => (parameters n).wordBits)
  keyWidth : PolynomiallyBounded (fun n => (parameters n).frame.shape.keyG₂.representation.encoding.words)
  indexWidth : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.rows.accumulation.cache.key.representation.encoding.words)
  messageWidth : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.rows.message.representation.encoding.words)
  scalarWidth : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.rows.accumulation.cache.value.representation.encoding.words)
  pointWidth : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.rows.point.representation.encoding.words)
  stateWidth : PolynomiallyBounded (fun n => (parameters n).frame.shape.state.encoding.words)
  slotCap : PolynomiallyBounded (fun n => (parameters n).frame.shape.slotCap)
  outWords : PolynomiallyBounded (fun n => (parameters n).frame.shape.outWords)
  cacheCapacity : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.rows.accumulation.cache.capacityPred)
  hashCapacity : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.hashes)
  signCapacity : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.signs)
  gammaCapacity : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.gamma)
  xiCapacity : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.xi)
  weightedTerms : PolynomiallyBounded (fun n => (parameters n).frame.shape.scheme.terms)
  outerHashes : PolynomiallyBounded (fun n => (parameters n).frame.caps.hashes)
  outerGamma : PolynomiallyBounded (fun n => (parameters n).frame.caps.gammaPred)
  keyNames : PolynomiallyBounded (fun n => (parameters n).keySlots)
  samplerNames : PolynomiallyBounded (fun n => (parameters n).samplerSlots)
  callerNames : PolynomiallyBounded (fun n => (parameters n).callerLimits.slots)
  keyTime : PolynomiallyBounded (fun n => (parameters n).keyBudget.time)
  keyWords : PolynomiallyBounded (fun n => (parameters n).keyBudget.words)
  samplerTime : PolynomiallyBounded (fun n => (parameters n).samplerBudget.time)
  samplerWords : PolynomiallyBounded (fun n => (parameters n).samplerBudget.words)
  localTime : PolynomiallyBounded (fun n => (parameters n).callerLimits.step.time)
  localWords : PolynomiallyBounded (fun n => (parameters n).callerLimits.step.words)
  initialTime : PolynomiallyBounded (fun n => (parameters n).callerLimits.initial.time)
  initialWords : PolynomiallyBounded (fun n => (parameters n).callerLimits.initial.words)
  wrap₁Names : PolynomiallyBounded (fun n => (parameters n).wrap₁.routines.slots)
  wrap₁Time : PolynomiallyBounded (fun n => (parameters n).wrap₁.routines.time)
  wrap₁Words : PolynomiallyBounded (fun n => (parameters n).wrap₁.routines.words)
  finish₁Names : PolynomiallyBounded (fun n => (parameters n).wrap₁.finish.slots)
  finish₁Time : PolynomiallyBounded (fun n => (parameters n).wrap₁.finish.time)
  finish₁Words : PolynomiallyBounded (fun n => (parameters n).wrap₁.finish.words)
  wrap₂Names : PolynomiallyBounded (fun n => (parameters n).wrap₂.routines.slots)
  wrap₂Time : PolynomiallyBounded (fun n => (parameters n).wrap₂.routines.time)
  wrap₂Words : PolynomiallyBounded (fun n => (parameters n).wrap₂.routines.words)
  finish₂Names : PolynomiallyBounded (fun n => (parameters n).wrap₂.finish.slots)
  finish₂Time : PolynomiallyBounded (fun n => (parameters n).wrap₂.finish.time)
  finish₂Words : PolynomiallyBounded (fun n => (parameters n).wrap₂.finish.words)
  good₁Names : PolynomiallyBounded (fun n => (parameters n).good₁.routines.slots)
  good₁GeneratorTime : PolynomiallyBounded (fun n => (parameters n).good₁.bounds.generator.time)
  good₁GeneratorWords : PolynomiallyBounded (fun n => (parameters n).good₁.bounds.generator.words)
  good₁UpdateTime : PolynomiallyBounded (fun n => (parameters n).good₁.bounds.update.time)
  good₁UpdateWords : PolynomiallyBounded (fun n => (parameters n).good₁.bounds.update.words)
  good₁HashTime : PolynomiallyBounded (fun n => ((parameters n).good₁.bounds.response false).time)
  good₁HashWords : PolynomiallyBounded (fun n => ((parameters n).good₁.bounds.response false).words)
  good₁SignTime : PolynomiallyBounded (fun n => ((parameters n).good₁.bounds.response true).time)
  good₁SignWords : PolynomiallyBounded (fun n => ((parameters n).good₁.bounds.response true).words)
  good₁ExtractTime : PolynomiallyBounded (fun n => (parameters n).good₁.bounds.extract.time)
  good₁ExtractWords : PolynomiallyBounded (fun n => (parameters n).good₁.bounds.extract.words)
