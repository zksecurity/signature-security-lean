  bad₂GeneratorTime : PolynomiallyBounded (fun n => (parameters n).bad₂.bounds.generator.time)
  bad₂GeneratorWords : PolynomiallyBounded (fun n => (parameters n).bad₂.bounds.generator.words)
  bad₂UpdateTime : PolynomiallyBounded (fun n => (parameters n).bad₂.bounds.update.time)
  bad₂UpdateWords : PolynomiallyBounded (fun n => (parameters n).bad₂.bounds.update.words)
  bad₂HashTime : PolynomiallyBounded (fun n => ((parameters n).bad₂.bounds.response false).time)
  bad₂HashWords : PolynomiallyBounded (fun n => ((parameters n).bad₂.bounds.response false).words)
