namespace PolynomialResources
variable {parameters} (resources : PolynomialResources parameters)
include resources

theorem requestWidth : PolynomiallyBounded (fun n =>
    (WeightedCallerPackets.request (parameters n).frame.shape.core.inner.good.service (parameters n).frame.shape.core.inner.randomBound
      (parameters n).frame.shape.core.inner.randomFits).encoding.words) := by
  cases resources
  caliper_polynomial

theorem replyWidth : PolynomiallyBounded (fun n =>
    (WeightedCallerPackets.reply (parameters n).frame.shape.core.inner.good.service (parameters n).frame.shape.core.inner.randomBound
      (parameters n).frame.shape.core.inner.randomFits).encoding.words) := by
  cases resources
  caliper_polynomial

theorem forgeryWidth : PolynomiallyBounded (fun n => (parameters n).frame.shape.core.inner.good.forgery.representation.encoding.words) := by
  cases resources
  caliper_polynomial

theorem coreWidth : PolynomiallyBounded (fun n => (parameters n).frame.shape.core.width) := by
  have request := resources.requestWidth
  have reply := resources.replyWidth
  have forgery := resources.forgeryWidth
  cases resources
  caliper_polynomial

theorem coreBound : PolynomiallyBounded (fun n => (parameters n).frame.shape.core.bound) := by
  have width := resources.coreWidth
  caliper_polynomial

theorem snocTime : PolynomiallyBounded (fun n => (parameters n).frame.shape.core.snocTime) := by
  have width := resources.coreWidth
  cases resources
  caliper_polynomial

theorem snocWords : PolynomiallyBounded (fun n => (parameters n).frame.shape.core.snocWords) := by
  have width := resources.coreWidth
  cases resources
  caliper_polynomial

theorem finishTime₁ : PolynomiallyBounded (fun n => (parameters n).frame.wrapper.finishTime (parameters n).outLe (parameters n).wrap₁.finish) := by
  have bound := resources.coreBound
  cases resources
  caliper_polynomial

theorem finishWords₁ : PolynomiallyBounded (fun n => (parameters n).frame.wrapper.finishWords (parameters n).outLe (parameters n).wrap₁.finish) := by
