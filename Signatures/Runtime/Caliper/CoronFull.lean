import Signatures.Runtime.Caliper.CoronCallerSource
import Signatures.Runtime.Caliper.BLSInitialization

/-! A complete Coron program: copy challenge configuration and caller input,
write the empty private cache/logs, run the caller/controller, and extract.
The initial private state is generated by instructions, not assumed present. -/
namespace Signatures.Runtime.CaliperBackend.CoronFull
open Caliper BoundedSource OracleComp OracleSpec
variable {w randomBound : Nat} {qS : Fin (randomBound + 1)} {M F G A U : Type}
    (service : CoronService.Layouts w M F G randomBound qS) (layout : CoronCaller.Layouts service A U)

def challenge : Layout w (U × service.service.config.Value) :=
  Layout.all (BLSInitialization.input service.service layout.input layout.inputFits)
def setup := BLSInitialization.code service.service layout.input layout.inputFits
def start (value : (challenge service layout).Value) : U × service.service.store.Value :=
  BLSInitialization.initialized service.service value.val
theorem start_ready (fuel : Nat) (cacheRoom : fuel + 1 ≤ service.service.cache.capacityPred + 1)
    (logRoom : fuel ≤ service.service.capacityPred + 1) (value : (challenge service layout).Value) :
    layout.ready fuel (start service layout value) := by
  change 0 + fuel + 1 ≤ service.service.cache.capacityPred + 1 ∧ 0 + 0 + fuel ≤ service.service.capacityPred + 1
  constructor <;> omega

variable [DecidableEq M] [SampleableType F] [SMul F G] [Add G] [Zero G] [Sub G]
    (default : service.cache.value.Value) (routines : CoronService.Routines service)
    (sampler : CoronService.Sampler service) (arithmetic : CoronTerminal.Arithmetic service)
    (caller : CoronCaller.Caller layout) (fuel : Nat) (fallback : service.point.Value)

def code : Interactive.Code w := .seq (.compute (setup service layout).code)
  (CoronCaller.code service layout default routines sampler arithmetic caller fuel fallback)
def denote (value : (challenge service layout).Value) : ProbComp service.point.Value :=
  CoronCaller.denote service layout default routines sampler arithmetic caller fuel fallback (start service layout value)

variable (invariant : CoronCaller.Caller.Invariant layout caller fuel)
    (cacheRoom : fuel + 1 ≤ service.service.cache.capacityPred + 1) (logRoom : fuel ≤ service.service.capacityPred + 1)
include invariant cacheRoom logRoom in
theorem refines : Interactive.Refines service.port .unit (challenge service layout).representation service.point.representation
    (denote service layout default routines sampler arithmetic caller fuel fallback)
    (code service layout default routines sampler arithmetic caller fuel fallback) := by
  have initialized := ((Interactive.Refines.compute service.port .unit (setup service layout)).viewInput
    (challenge service layout).representation Subtype.val (fun _ => rfl)).on (fun _ => True)
  have composed := initialized.seq (CoronCaller.refines service layout default routines sampler arithmetic caller fuel fallback invariant) (by
    intro value _ answer reached
    simp only [support_pure, Set.mem_singleton_iff] at reached
    subst answer
    exact start_ready service layout fuel cacheRoom logRoom value)
  intro tape value before holds
  simpa only [pure_bind, denote, start, code] using composed tape value trivial before holds

end Signatures.Runtime.CaliperBackend.CoronFull
